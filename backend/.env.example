# Deje N8N_WEBHOOK_URL vacía para usar el modo simulación
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=cambie-este-secreto
PUBLIC_BASE_URL=http://localhost:5000
COORDINADOR_EMAIL=coordinador@arkof.example
COORDINADOR_TELEFONO=+570000000000
VIGILANTE_SLA=1
# SLA_DEMO_MIN=1

# Modo demostración con envíos reales: todas las notificaciones (brigadistas,
# cliente y coordinador) llegan a estos datos. Borre instance/*.db tras cambiarlos.
# DEMO_EMAIL=tu_correo@gmail.com
# DEMO_TELEFONO=+57XXXXXXXXXX

# Sesiones y cuentas de demostración
# SECRET_KEY=cambie-esta-clave-larga-y-aleatoria
# CLAVE_DEMO=clave-de-las-cuentas-de-demo   (se aplica al crear la base; borre instance/*.db al cambiarla)

# Variables que lee n8n local (node n8n/iniciar_n8n.mjs las toma de este archivo)
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# ARKOF_CORREO_REMITENTE=tu_correo@gmail.com

# Canal de DEMOSTRACIÓN por Telegram (el SMS de Twilio requiere plan pago para Colombia).
# Su chat_id: escríbale a @userinfobot en Telegram y copie el número "Id".
# DEMO_TELEGRAM_CHAT_ID=123456789
