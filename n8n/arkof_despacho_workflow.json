    {
      "id": "d07f6ab3-1658-45a2-b3a2-6b736e1d446f",
      "name": "Un ítem por brigadista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        60
      ],
      "parameters": {
        "jsCode": "// Convierte la lista de destinatarios en un ítem por brigadista y deja los textos listos para el correo y el SMS\nconst b = $input.first().json.body;\nconst TIPOS = { DERRAME_HIDROCARBURO: 'Derrame de hidrocarburo', SUSTANCIA_NOCIVA: 'Sustancia nociva', FUGA_GAS: 'Fuga de gas' };\nconst ROLES = { lider: 'líder', tecnico: 'técnico' };\nreturn (b.destinatarios || []).map(d => ({ json: {\n  ...d,\n  rol_texto: ROLES[d.rol] || d.rol,\n  tipo_texto: TIPOS[b.incidente.tipo] || b.incidente.tipo,\n  incidente: b.incidente, evento: b.evento, sla_minutos: b.sla_minutos,\n} }));"
      }
    },
    {
      "id": "991c5e53-3d57-4540-8d77-75bdc1941ac8",
      "name": "Correo al brigadista",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        800,
        -40
      ],
      "credentials": {
        "smtp": {
          "id": "CONFIGURAR",
          "name": "SMTP ARKOF (configurar)"
        }
      },
      "parameters": {
        "fromEmail": "={{ $env.ARKOF_CORREO_REMITENTE ? 'Despacho ARKOF <' + $env.ARKOF_CORREO_REMITENTE + '>' : 'Despacho ARKOF <despacho@arkof.example>' }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.evento === 'escalamiento' ? '[Reasignación] ' : '' }}ARKOF {{ $json.incidente.codigo }} · {{ $json.nombre }} ({{ $json.rol_texto }}): {{ $json.tipo_texto }} nivel {{ $json.incidente.nivel }} en {{ $json.incidente.municipio }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:520px;color:#1f2c35\"><p style=\"background:#1F3B4D;color:#fff;padding:10px 14px;margin:0;font-weight:bold\">{{ $json.evento === 'escalamiento' ? 'Reasignación: ' : '' }}Convocatoria ARKOF {{ $json.incidente.codigo }}</p><div style=\"border:1px solid #1F3B4D;border-top:0;padding:14px;background:#FBEBCF\"><p>Hola {{ $json.nombre }}, el sistema lo asignó como <b>{{ $json.rol_texto }}</b>.</p><p>{{ $json.tipo_texto }} · <b>nivel {{ $json.incidente.nivel }}</b><br>Municipio: {{ $json.incidente.municipio }} ({{ $json.distancia_km }} km de su base)<br>Cliente: {{ $json.incidente.empresa }}</p><p>Tiene <b>{{ $json.sla_minutos }} minutos</b> para responder.</p><p><a href=\"{{ $json.url_confirmar }}\" style=\"display:inline-block;background:#3F5E48;color:#fff;padding:12px 18px;text-decoration:none;font-weight:bold\">Confirmo, voy en camino</a>&nbsp; <a href=\"{{ $json.url_rechazar }}\" style=\"color:#8A5A2B;font-weight:bold\">No estoy disponible</a></p><p style=\"font-size:13px;color:#56626b\">También puede responder en el portal del brigadista ({{ $json.url_portal }}) con su usuario <b>{{ $json.usuario }}</b>.</p></div></div>",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "d064da8c-d590-4e72-a823-c6ba169d0d18",
      "name": "SMS al brigadista",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
