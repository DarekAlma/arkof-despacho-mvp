        "from": "={{ $env.TWILIO_FROM_NUMBER || '+15005550006' }}",
        "to": "={{ $json.telefono }}",
        "message": "=ARKOF {{ $json.incidente.codigo }} Nivel {{ $json.incidente.nivel }} en {{ $json.incidente.municipio }}. Rol: {{ $json.rol_texto }}. Responda en {{ $json.sla_minutos }} min: {{ $json.url_confirmar }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "disabled": true
    },
